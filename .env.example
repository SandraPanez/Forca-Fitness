PORT=3000

# PostgreSQL local
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=forca_fitness
DB_SSL=false

# Redis Cloud
REDIS_HOST=hole-cup-soup-40650.db.redis.io
REDIS_PORT=19655
REDIS_USERNAME=default
REDIS_PASSWORD=change_me
REDIS_TLS=false
# También puedes definir REDIS_URL directamente.
# REDIS_URL=redis://default:change_me@hole-cup-soup-40650.db.redis.io:19655

# En Render usa la Internal Database URL de tu PostgreSQL como variable.
# No definas las variables DB_* al mismo tiempo en producción.
# DATABASE_URL=postgresql://usuario:password@host:5432/forca_fitness
